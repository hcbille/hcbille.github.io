// Cloudflare Workers settings for hcbille.se: a static site, no server code.
// Workers Builds runs `npm run build`, then `npx wrangler deploy` uploads _site/.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hcbille-se",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./_site",
    // Unknown addresses get 404.html with a 404 status
    "not_found_handling": "404-page"
  },
  // The free *.workers.dev address, for checking a deploy before the domain moves
  "workers_dev": true,
  // A preview link for every branch that isn't main
  "preview_urls": true
}
